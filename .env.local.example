# ===== 必要变量 =====

# DeepSeek Chat 模型
DEEPSEEK_API_KEY=sk-your-deepseek-key

# 智谱 AI Embedding 模型（embedding-3, 1024 维）
ZHIPU_API_KEY=xxxxxxxx.xxxxxxxx

# Supabase 数据库（pgvector + BM25 全文索引）
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIs...

# Tavily Web 搜索（Stage 2 Agent 联网查询）
TAVILY_API_KEY=tvly-your-tavily-key

# ===== 可选变量 =====

# 硅基流动 Rerank 精排（bge-reranker-v2-m3，无 key 时自动降级为纯 RRF）
SILICONFLOW_API_KEY=sk-your-siliconflow-key

# 2-Stage Pipeline（默认开启，设为 'false' 回退到单 Agent 模式）
# ENABLE_PIPELINE=true

# MCP 协议（默认关闭，Vercel 部署不支持 spawn 子进程请勿开启）
# ENABLE_MCP=false

# ===== LangSmith 追踪（可选，开发调试用）=====
# LANGCHAIN_API_KEY=ls__your-key
# LANGCHAIN_TRACING=true
# LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
# LANGCHAIN_PROJECT=doc-qa-agent
